{
  "name": "reviewlution",
  "version": "0.1.0",
  "description": "Review toolbar for web apps: element-anchored comment pins, replies and a comments API for agents. Runs as a React component inside the app, or as a proxy that frames any app.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raviautar/reviewlution.git"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/lib.d.ts",
      "import": "./dist-lib/lib.js"
    }
  },
  "types": "./dist-lib/lib.d.ts",
  "files": [
    "dist-lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "start": "node server.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test hub.test.mjs"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.1.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "modern-screenshot": "^4.7.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
